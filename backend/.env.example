# Project Settings
PROJECT_NAME="E-commerce Profit & Ads Intelligence SaaS"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Neon PostgreSQL Database Connection URL
# Replace with your actual Neon connection string:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="sqlite+aiosqlite:///./ecommerce_dev.db"

# Security & JWT Token Config
SECRET_KEY="replace_this_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (Comma-separated in list)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

